        <field id="channelAvatar" type="string" onChange="updateChatHeader" />
        <field id="viewerText" type="string" onChange="updateChatHeader" />
        <field id="control" type="boolean" onChange="onVideoChange" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Chat.brs" />
    <children>
        <Rectangle color="0x08080aFF" width="360" height="720" translation="[920,0]" />
        <Rectangle color="0x303038FF" width="360" height="92" translation="[920,0]" />
        <Poster id="channelAvatar" width="58" height="58" translation="[937,17]" loadDisplayMode="scaleToZoom" />
        <Rectangle color="0xe91916FF" width="32" height="14" translation="[950,67]" />
        <SimpleLabel text="LIVE" translation="[966,76]" horizOrigin="center" vertOrigin="center" fontUri="font:BoldSystemFontFile" fontSize="9" />
        <Label id="channelName" width="252" height="27" translation="[1012,16]" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/TwokuUnicode-Regular.ttf" size="21" />
        </Label>
        <Label id="viewers" width="252" height="30" translation="[1012,45]" color="0xD9DCE4FF">
            <Font role="font" uri="font:SystemFontFile" size="21" />
        </Label>
        <Group id="chatPanel" translation="[932,104]" />
        <LoadingIndicator id="busy" translation="[1076,144]" size="48" />
        <Label id="status" text="" visible="false" width="336" height="604" wrap="true" horizAlign="center" vertAlign="center" translation="[932,104]" color="0xa9a9b2FF">
            <Font role="font" uri="font:SystemFontFile" size="17" />
        </Label>
    </children>
</component>
