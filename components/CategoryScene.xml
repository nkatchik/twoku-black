        <RowList id="browseClipsList" itemComponentName="BrowseChannelItem" translation="[43,294]" numRows="2"
            rowItemSize="[[292,164]]" rowItemSpacing="[[10,0]]" itemSize="[1198,247]"
            focusBitmapUri="pkg:/images/twellie-focus.9.png"
                focusFootprintBitmapUri="pkg:/images/twellie-focus.9.png" focusFootprintBlendColor="0xFFFFFF00" rowFocusAnimationStyle="floatingFocus" visible="false" />
        <Label id="emptyLabel" translation="[43,380]" width="1194" height="100" horizAlign="center" color="0x5C5C66FF" text="" visible="false">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <LoadingIndicator id="busy" translation="[608,442]" size="64" />
        <Label id="playbackStatus" translation="[690,44]" width="545" height="44" horizAlign="right" wrap="true" color="0xFFD479FF">
            <Font role="font" uri="font:SystemFontFile" size="16" />
        </Label>
    </children>

</component>
