<?xml version="1.0" encoding="utf-8" ?>
<component name="LoadingIndicator" extends="Group">
    <interface>
        <field id="active" type="boolean" value="false" onChange="updateActivity" />
        <field id="enabled" type="boolean" value="true" onChange="updateActivity" />
        <field id="size" type="float" value="64" onChange="updateSpinnerSize" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LoadingIndicator.brs" />
    <children>
        <BusySpinner id="spinner" clockwise="true" spinInterval="1.2" />
    </children>
</component>
