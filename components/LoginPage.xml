<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginPage" extends="Group">
    <interface>
        <field id="finished" type="boolean" />
        <field id="accountName" type="string" value="" />
        <field id="logoutRequested" type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LoginPage.brs" />
    <children>
        <Rectangle width="1280" height="720" color="0x08080AFF" />
        <Group id="pendingView">
        <Label translation="[180,48]" width="920" horizAlign="center" text="Sign in to Twitch" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="34" />
        </Label>
        <Label id="qrHelp" translation="[720,130]" width="400" horizAlign="center" text="Scan with your phone" visible="false" color="0xC8C8CFFF">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
        <Poster id="qr" translation="[740,180]" width="360" height="360" loadDisplayMode="limitSize" visible="false" />
        <Label translation="[140,195]" width="480" horizAlign="center" text="Open this address" color="0xC8C8CFFF">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
        <Label id="address" translation="[120,234]" width="520" horizAlign="center" text="www.twitch.tv/activate" color="0xF4F4F7FF">
            <Font role="font" uri="font:BoldSystemFontFile" size="24" />
        </Label>
        <Label translation="[140,300]" width="480" horizAlign="center" text="and enter the code" color="0xC8C8CFFF">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
        <Label id="code" translation="[100,348]" width="560" height="85" horizAlign="center" color="0xF4F4F7FF">
            <Font role="font" uri="font:BoldSystemFontFile" size="54" />
        </Label>
        <Label translation="[630,315]" width="70" text="or" horizAlign="center" color="0xA0A0A8FF">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <Label id="status" translation="[160,572]" width="960" height="70" horizAlign="center" wrap="true" text="" color="0xC8C8CFFF">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
        <Label id="hint" translation="[160,662]" width="960" horizAlign="center" text="Press Back to cancel." color="0xA0A0A8FF">
            <Font role="font" uri="font:SystemFontFile" size="17" />
        </Label>
        <LoadingIndicator id="busy" translation="[352,348]" size="56" />
        </Group>
        <Group id="accountView" translation="[260,180]" visible="false">
            <Poster translation="[358,0]" uri="pkg:/images/twellie-logo.png" width="44" height="44" loadDisplayMode="scaleToFit" />
            <Label translation="[0,64]" width="760" height="48" text="Twitch account" horizAlign="center" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="34" />
            </Label>
            <Label id="accountLabel" translation="[0,130]" width="760" height="60" wrap="true" horizAlign="center" color="0xC8C8CFFF">
                <Font role="font" uri="pkg:/fonts/TwokuUnicode-Regular.ttf" size="24" />
            </Label>
            <Rectangle translation="[250,230]" width="260" height="64" color="0xF4F4F7FF">
                <Label width="260" height="64" text="Log out" horizAlign="center" vertAlign="center" color="0x18181BFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="24" />
                </Label>
            </Rectangle>
            <Label translation="[0,330]" width="760" text="Back to return" horizAlign="center" color="0xA0A0A8FF">
                <Font role="font" uri="font:SystemFontFile" size="17" />
            </Label>
        </Group>
    </children>
</component>
