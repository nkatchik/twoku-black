        <Label id="emptyLabel" translation="[43,345]" width="1194" height="110" horizAlign="center" color="0x5C5C66FF" visible="false">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <LoadingIndicator id="busy" translation="[612,392]" size="56" />
        <Label id="playbackStatus" translation="[690,44]" width="545" height="44" horizAlign="right" wrap="true" color="0xFFD479FF">
            <Font role="font" uri="font:SystemFontFile" size="16" />
        </Label>
    </children>

</component>
