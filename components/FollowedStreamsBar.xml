<?xml version="1.0" encoding="utf-8" ?>

<component name="FollowedStreamsBar" extends="Group">

    <interface>
        <field id="focused" type="bool" value="false" onChange="onGetFocus" />
        <field id="streamerSelected" type="string" alwaysNotify="true" />
        <field id="followedStreams" type="array" onChange="onFollowedStreamsChange" />
        <field id="loggedIn" type="boolean" value="false" onChange="updateEmptyState" />
        <field id="loginRequested" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/FollowedStreamsBar.brs" />

    <children>

        <Rectangle
            visible="true"
            color="0x26262CFF"
            width="78"
            height="1000"
            translation="[0,0]">
            <Label id="emptyLabel" translation="[5,45]" width="68" height="50"
                text="Login" font="font:SmallSystemFont" horizAlign="center" wrap="true" />
            <Group id="emptyHint" translation="[78,40]" visible="false">
                <Rectangle color="0x26262CFF" width="355" height="88" />
                <Label id="emptyHintText" translation="[12,12]" width="331" height="64"
                    font="font:SmallSystemFont" wrap="true"
                    text="Sign in to see followed channels. Press OK to log in." />
            </Group>
        </Rectangle>
        
        <Poster
            uri="pkg:/images/live_rectangle.9.png"
            width="50"
            height="20"
            translation="[10,10]" >
            <Label
                text = "LIVE"
                horizAlign = "left"
                color = "0xFFFFFFFF"
                translation = "[17,1]" >
                <Font role = "font" uri = "font:SystemFontFile" size = "12" />
            </Label>
            <Poster
                uri="pkg:/images/live.png"
                translation="[5,5]" />
        </Poster>

    </children>

</component>
