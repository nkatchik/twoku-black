<?xml version="1.0" encoding="utf-8" ?>

<component name="ChannelPage" extends="Group">

    <interface>
        <function name="reloadContent" />
        <function name="cancelPlaybackRequest" />
        <field id="parentVisible" type="boolean" value="true" onChange="onGetFocus" />
        <function name="focusContent" />
        <field id="playbackInfo" type="assocarray" />
        <field id="streamUrl" type="string" alwaysNotify="true" />
        <field id="videoUrl" type="string" alwaysNotify="true" />
        <field id="thumbnailInfo" type="assocarray" />

        <field id="streamerSelectedName" type="string" alwaysNotify="true" />
        <field id="streamerSelectedThumbnail" type="string" />
        <field id="streamViewers" type="string" />

        <field id="channelAvatar" type="string" alias="avatar.uri" />
        <field id="channelUsername" type="string" alias="username.text" />
        <field id="videoTitle" type="string" />
        <field id="streamDurationSeconds" type="Integer" />

        <field id="streamItemFocused" type="bool" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/ChannelPage.brs" />
    <script type="text/brightscript" uri="pkg:/components/GridPagination.brs" />

    <children>
        <Timer id="liveStatusTimer" duration="60" repeat="true" />
        <Rectangle width="1280" height="720" color="0x08080AFF" />
        <Group id="header" translation="[43,36]">
            <Group id="profileImageMask">
                <Rectangle width="96" height="96" color="0x18181BFF" />
                <Poster id="avatar" width="96" height="96" loadDisplayMode="scaleToFill" />
                <Poster width="96" height="96" uri="pkg:/images/twellie-avatar-cover.png" blendColor="0x08080AFF" loadDisplayMode="scaleToFit" />
            </Group>
            <Label id="username" translation="[124,0]" width="1070" height="44" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/TwokuUnicode-Regular.ttf" size="34" />
            </Label>
            <Label id="followers" translation="[124,47]" width="1070" height="24" color="0xADADB8FF">
                <Font role="font" uri="font:SystemFontFile" size="18" />
            </Label>
            <Label id="description" translation="[124,76]" width="1070" height="52" wrap="true" color="0xC8C8CFFF">
                <Font role="font" uri="pkg:/fonts/TwokuUnicode-Regular.ttf" size="18" />
            </Label>
        </Group>
        <RowList id="pastBroadcastsList" itemComponentName="ChannelPageItem" translation="[43,172]"
