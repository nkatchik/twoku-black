        <RowList id="browseList" itemComponentName="BrowseChannelItem" translation="[43,294]" numRows="2"
            rowItemSize="[[292,164]]" rowItemSpacing="[[10,0]]" itemSize="[1198,247]"
            focusBitmapUri="pkg:/images/twellie-focus.9.png"
