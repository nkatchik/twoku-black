<?xml version="1.0" encoding="utf-8" ?>

<component name="KeyboardGroup" extends="Group" initialFocus="keyboard">

    <interface>
        <function name="reloadContent" />
        <function name="cancelPlaybackRequest" />
        <field id="playbackInfo" type="assocarray" />
        <field id="liveTitle" type="string" />
        <field id="liveName" type="string" />
        <field id="liveGame" type="string" />
        <field id="liveViewers" type="string" />
        <field id="categorySelectedName" type="string" />
        <field id="categorySelectedImage" type="string" />
        <function name="focusContent" />
        <field id="streamUrl" type="uri" alwaysNotify="true" />
        <field id="streamerSelectedName" type="string" alwaysNotify="true" />

        <field id="streamerRequested" type="string" />
        <field id="categorySelected" type="string" alwaysNotify="true" />
        <field id="searchText" type="string" alias="keyboard.text" alwaysNotify="true" onChange="onSearchTextChange" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/KeyboardGroup.brs" />

    <children>
        <Rectangle width="1280" height="720" color="0x08080AFF" />
        <SimpleLabel id="searchHeader" translation="[43,61]" vertOrigin="center" text="Search" fontSize="24" fontUri="font:BoldSystemFontFile" />
        <Group id="browseButtons" focusable="true" translation="[250,0]">
            <SimpleLabel id="liveButton" translation="[0,61]" vertOrigin="center" text="Channels" color="0xF4F4F7FF" fontSize="20" fontUri="font:SystemFontFile" />
            <Rectangle id="liveLine" width="1" height="3" color="0xF4F4F7FF" translation="[0,75]" />
            <SimpleLabel id="categoryButton" translation="[160,61]" vertOrigin="center" text="Games" color="0xA9A9B2FF" fontSize="20" fontUri="font:SystemFontFile" />
            <Rectangle id="categoryLine" width="1" height="3" color="0xF4F4F7FF" translation="[160,75]" visible="false" />
        </Group>
        <MiniKeyboard id="keyboard" translation="[43,130]" />
        <MarkupList id="resultList" itemComponentName="SearchResultItem" numRows="5" itemSize="[650,88]"
            itemSpacing="[0,18]" translation="[570,130]" focusBitmapUri="pkg:/images/twellie-focus.9.png"
                focusFootprintBitmapUri="pkg:/images/twellie-focus.9.png" focusFootprintBlendColor="0xFFFFFF00" />
        <MarkupList id="resultCategoryList" itemComponentName="SearchCategoryResultItem" numRows="5" itemSize="[650,88]"
            itemSpacing="[0,18]" translation="[570,130]" focusBitmapUri="pkg:/images/twellie-focus.9.png"
                focusFootprintBitmapUri="pkg:/images/twellie-focus.9.png" focusFootprintBlendColor="0xFFFFFF00" visible="false" />
        <Label id="emptyLabel" translation="[570,285]" width="650" height="160" text="Search for a channel" color="0x5C5C66FF" wrap="true" horizAlign="center">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <LoadingIndicator id="busy" translation="[864,332]" size="64" />
        <TimedLabel id="playbackStatus" translation="[690,44]" width="545" height="44" horizAlign="right" wrap="true" color="0xFFD479FF">
            <Font role="font" uri="font:SystemFontFile" size="16" />
        </TimedLabel>
    </children>

</component>
